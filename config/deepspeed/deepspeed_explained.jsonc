// DeepSpeed inference-focused configuration with ZeRO Stage 3 parameter sharding.
// This JSONC file (allows // comments) is for documentation only.
// Use the original deepspeed.json (without comments) when launching.
{
  // Global effective batch size (not really used for pure inference, but DS expects it present)
  "train_batch_size": 1,

  // Per-GPU micro batch (number of samples each rank processes per forward pass)
  "micro_batch_size_per_gpu": 1,

  // Number of micro-batches accumulated before an optimizer step (kept at 1 for inference)
  "gradient_accumulation_steps": 1,

  // Enable bfloat16 execution (prefer over fp16 on hardware with native BF16 like A100/H100)
  "fp16": { "enabled": true },

  // Inference-specific settings; kernel injection disabled to avoid conflicts with custom patching
  "inference": {
    // Primary compute dtype for inference layers
    "dtype": "fp16",
    // Whether to let DeepSpeed swap certain modules with optimized kernels automatically
    "replace_with_kernel_inject": false
  },

  // ZeRO optimization block controls parameter sharding behavior
  "zero_optimization": {
    // Stage 3 shards parameters themselves (max memory savings for large models)
    "stage": 3,
    // Try to hide network latency by overlapping all-gathers with compute
    "overlap_comm": true,
    // Gradient layout optimization unnecessary for inference (no grads), so left false for minimal overhead
    "contiguous_gradients": false,
    // Params smaller (element count) than this may remain persistent to reduce gather churn
    "stage3_param_persistence_threshold": 100000,
    // Soft upper bound hints for DS heuristics—large values effectively disable early eviction
    "stage3_max_live_parameters": 1000000000,
    "stage3_max_reuse_distance": 1000000000,
    // Avoid reconstructing full 16-bit weights when/if a save() is invoked (saves memory/time)
    "stage3_gather_16bit_weights_on_model_save": false
  },

  // Disable per-phase timing breakdown unless profiling; set true to analyze comm/compute split
  "wall_clock_breakdown": false
}